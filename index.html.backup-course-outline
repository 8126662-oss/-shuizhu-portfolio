    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // FAQ 交互功能
            const faqItems = document.querySelectorAll('.faq-item');
            faqItems.forEach(item => {
                const question = item.querySelector('.faq-question');
                question.addEventListener('click', () => {
                    item.classList.toggle('active');
                });
            });

            // 课程展示区滚动动画
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, observerOptions);

            const comparisonItems = document.querySelectorAll('.comparison-item');
            comparisonItems.forEach(item => {
                observer.observe(item);
            });

            // 音乐控制功能
            const audio = document.getElementById('background-music');
            const musicControl = document.getElementById('music-control');
            const playIcon = musicControl.querySelector('.play-icon');
            const pauseIcon = musicControl.querySelector('.pause-icon');
            let isPlaying = false;

            // 初始音量
            audio.volume = 0.5;

            // 更新图标状态
            function updateMusicIcon(playing) {
                if (playing) {
                    playIcon.style.display = 'flex';
                    pauseIcon.style.display = 'none';
                } else {
                    playIcon.style.display = 'none';
                    pauseIcon.style.display = 'flex';
                }
            }

            // 尝试自动播放
            async function tryAutoplay() {
                try {
                    await audio.play();
                    isPlaying = true;
                    updateMusicIcon(true);
                    console.log('音乐自动播放成功');
                } catch (err) {
                    // 自动播放被阻止，等待用户交互
                    isPlaying = false;
                    updateMusicIcon(false);
                    console.log('自动播放被阻止，等待用户交互');
                    
                    // 添加一次性交互监听器来启动播放
                    const startOnInteraction = async () => {
                        if (!isPlaying) {
                            try {
                                await audio.play();
                                isPlaying = true;
                                updateMusicIcon(true);
                                // 移除交互监听器
                                document.removeEventListener('click', startOnInteraction);
                                document.removeEventListener('scroll', startOnInteraction);
                                document.removeEventListener('keydown', startOnInteraction);
                            } catch (e) {
                                console.log('播放失败:', e);
                            }
                        }
                    };
                    
                    document.addEventListener('click', startOnInteraction, { once: true });
                    document.addEventListener('scroll', startOnInteraction, { once: true });
                    document.addEventListener('keydown', startOnInteraction, { once: true });
                }
            }

            // 页面加载完成后尝试自动播放
            if (document.readyState === 'complete') {
                tryAutoplay();
            } else {
                window.addEventListener('load', tryAutoplay);
            }

            // 监听音频实际播放状态
            audio.addEventListener('play', () => {
                isPlaying = true;
                updateMusicIcon(true);
            });

            audio.addEventListener('pause', () => {
                isPlaying = false;
                updateMusicIcon(false);
            });

            // 手动切换播放/暂停按钮
            musicControl.addEventListener('click', async function(e) {
                e.stopPropagation(); // 防止触发页面交互监听器
                
                if (!isPlaying) {
                    try {
                        await audio.play();
                    } catch (err) {
                        console.log('播放失败:', err);
                    }
                } else {
                    audio.pause();
                }
            });

            // 交互对比滑块功能
            const sliders = document.querySelectorAll('.image-slider');
            sliders.forEach(slider => {
                const container = slider.querySelector('.slider-container');
                const after = slider.querySelector('.slider-after');
                const handle = slider.querySelector('.slider-handle');
                let isDragging = false;

                function updateSlider(e) {
                    const rect = container.getBoundingClientRect();
                    let x = e.clientX - rect.left;
                    x = Math.max(0, Math.min(x, rect.width));
                    const percentage = (x / rect.width) * 100;
                    after.style.width = `${percentage}%`;
                    handle.style.left = `${percentage}%`;
                }

                // 专业竖向分割线滑块 - 丝滑跟手逻辑
                window.updateWinkSlider = function(sliderInput, sliderId) {
                    const percentage = sliderInput.value;
                    updateClipPath(percentage, sliderId);
                    updateSliderPosition(sliderInput, sliderId);
                };

                // 更新clip-path（零延迟）
                function updateClipPath(percentage, sliderId) {
                    const slider = document.getElementById(sliderId);
                    if (slider) {
                        const after = slider.querySelector('.slider-after');
                        if (after) {
                            // 实时更新clip-path，无transition延迟
                            // inset(top right bottom left)
                            // (100 - percentage)% 表示从右侧裁剪多少
                            after.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
                        }
                    }
                }

                // 更新滑块位置（实时跟手）
                function updateSliderPosition(sliderInput, sliderId) {
                    const percentage = sliderInput.value;
                    const slider = document.getElementById(sliderId);
                    if (slider) {
                        const divider = slider.querySelector('.slider-divider');
                        const knob = slider.querySelector('.slider-knob');
                        if (divider && knob) {
                            // 实时更新分割线和圆钮位置
                            const leftPosition = `${percentage}%`;
                            divider.style.left = leftPosition;
                            knob.style.left = leftPosition;
                        }
                    }
                }

                // 初始化滑块位置和视觉元素
                document.addEventListener('DOMContentLoaded', function() {
                    // 初始化第一个滑块
                    const slider1 = document.getElementById('slider1');
                    if (slider1) {
                        const after1 = slider1.querySelector('.slider-after');
                        const divider1 = slider1.querySelector('.slider-divider');
                        const knob1 = slider1.querySelector('.slider-knob');
                        const range1 = slider1.querySelector('.slider-range');
                        
                        if (after1) after1.style.clipPath = 'inset(0 50% 0 0)';
                        if (divider1) divider1.style.left = '50%';
                        if (knob1) knob1.style.left = '50%';
                        if (range1) range1.value = '50';
                    }
                    
                    // 初始化第二个滑块
                    const slider2 = document.getElementById('slider2');
                    if (slider2) {
                        const after2 = slider2.querySelector('.slider-after');
                        const divider2 = slider2.querySelector('.slider-divider');
                        const knob2 = slider2.querySelector('.slider-knob');
                        const range2 = slider2.querySelector('.slider-range');
                        
                        if (after2) after2.style.clipPath = 'inset(0 50% 0 0)';
                        if (divider2) divider2.style.left = '50%';
                        if (knob2) knob2.style.left = '50%';
                        if (range2) range2.value = '50';
                    }
                });

                handle.addEventListener('mousedown', () => {
                    isDragging = true;
                });

                document.addEventListener('mousemove', (e) => {
                    if (isDragging) {
                        updateSlider(e);
                    }
                });

                document.addEventListener('mouseup', () => {
                    isDragging = false;
                });

                container.addEventListener('click', (e) => {
                    updateSlider(e);
                });
            });
        });
    </script>
