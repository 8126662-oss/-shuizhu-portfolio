/* === 涓撲笟绔栧悜鍒嗗壊绾挎粦鍧?- 涓濇粦璺熸墜鏁堟灉 === */

/* 婊戝潡瀹瑰櫒 - 瑕嗙洊鏁翠釜鍥剧墖鍖哄煙 */
.slider-control {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 20; /* 纭繚鍦ㄦ渶涓婂眰 */
    cursor: ew-resize;
}

/* 闅愯棌鍘熺敓婊戝潡锛屼娇鐢ㄨ嚜瀹氫箟绔栧悜鍒嗗壊绾?*/
.slider-range {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0; /* 瀹屽叏閫忔槑浣嗗彲浜や簰 */
    cursor: ew-resize;
    z-index: 21;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
}

/* 绔栧悜鍒嗗壊绾?- 鐧借壊鍗婇€忔槑绔栫嚎 */
.slider-divider {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 100%;
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
    z-index: 19;
    pointer-events: none;
}

/* 鍦嗛挳 - 鍥哄畾鍦ㄧ珫鍚戝垎鍓茬嚎涓棿 */
.slider-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid white;
    box-shadow: 
        0 0 15px rgba(255, 255, 255, 0.8),
        0 4px 12px rgba(0, 0, 0, 0.3);
    z-index: 22;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 鍦嗛挳鍐呴儴瑁呴グ */
.slider-knob::before {
    content: '';
    width: 4px;
    height: 16px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 2px;
}

/* 婊戝潡thumb鏍峰紡 - 淇濇寔闅愯棌浣嗗彲浜や簰 */
.slider-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 40px;
    height: 100%;
    background: transparent;
    cursor: ew-resize;
}

.slider-range::-moz-range-thumb {
    width: 40px;
    height: 100%;
    background: transparent;
    cursor: ew-resize;
}

/* === 淇锛氳皟鏁村浘灞傞『搴忓拰瑁佸壀鏂瑰悜 === */

/* 搴曞眰锛欱efore鍥撅紙鍘熷鍥撅級浣滀负鑳屾櫙 */
.slider-before {
    z-index: 1;
    /* 纭繚Before鍥惧崰婊″鍣ㄤ綔涓鸿儗鏅?*/
    width: 100% !important;
    height: 100% !important;
}

/* 椤跺眰锛欰fter鍥撅紙绮句慨鍚庯級浣跨敤clip-path瀹炵幇鏄剧ず鏁堟灉 */
.slider-after {
    z-index: 2;
    /* 鍒濆鏄剧ず宸︿晶50%鐨凙fter鍥?*/
    clip-path: inset(0 50% 0 0);
    will-change: clip-path; /* GPU鍔犻€燂紝娑堥櫎鍗￠】 */
    /* 娉ㄦ剰锛氱Щ闄ゆ墍鏈塼ransition灞炴€э紝瀹炵幇闆跺欢杩熻窡鎵?*/
}

/* 婊戝潡鎺т欢浣嶇疆淇 - 鎮诞鍦ㄥ浘鐗囨涓婃柟 */
.slider-control {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: 0 20px;
}












/* 强制执行：重构3D堆叠动画 */

    
    /* 阶段3: 展开展示 (40-75%) */
    75% {
        transform: 
            rotateX(55deg) 
            rotateY(0deg) 
            rotateZ(-360deg) 
            scale(0.6); /* 保持3D透视角度 */
    }
    
    /* 阶段4: 合拢回正 (75-100%) */
    100% {
        transform: 
            rotateX(0deg) 
            rotateY(0deg) 
            rotateZ(0deg) 
            scale(1.3); /* 回到初始状态 */
    }
}

/* 强制执行：图层动画 */

    
    /* 阶段3: 完全展开 (40-75%) */
    75% {
        /* 强制执行：Z轴间距 - 第5层120px, 第4层60px, 第3层0, 第2层-60px, 第1层-120px */
        transform: 
            translateZ(calc((var(--layer-index) - 2) * 60px)) 
            translateX(calc(var(--layer-index) * 15px)) 
            translateY(calc(var(--layer-index) * 15px));
        opacity: 0.95;
    }
    
    /* 阶段4: 合拢回正 (75-100%) */
    100% {
        transform: 
            translateZ(0) 
            translateX(0) 
            translateY(0);
        opacity: 1;
    }
}












