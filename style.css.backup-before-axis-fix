/* 【紧急任务：强制重写 3D 堆叠动画，回归"紧凑版"逻辑】 */

/* 图层堆叠容器 - 强制重写 */
.layer-stack-container {
    position: relative;
    width: min(600px, 85vw);
    aspect-ratio: 16 / 9; /* 强制16:9横向比例 */
    margin: 100px auto; /* 通过margin增加上下空间 */
    transform-style: preserve-3d;
    transform-origin: center center;
    perspective: 4000px; /* 紧急任务：必须是长焦透视，防止图片变形 */
    -webkit-font-smoothing: subpixel-antialiased;
    animation: compactContainerAnimation 12s ease-in-out infinite;
}

/* 容器动画 - 紧凑版逻辑 */
@keyframes compactContainerAnimation {
    /* 0% - 20%（初始海报态）: 05层全屏显示 */
    0%, 20% {
        transform: 
            rotateX(0deg) 
            rotateY(0deg) 
            rotateZ(0deg) 
            scale(1.3); /* 05层全屏显示 */
    }
    
    /* 20% - 45%（360° 旋转入场）: 缩小并落位 */
    45% {
        transform: 
            rotateX(55deg) 
            rotateY(0deg) 
            rotateZ(-360deg) 
            scale(0.6); /* 缩小并落位 */
    }
    
    /* 45% - 75%（紧凑展开态）: 保持3D透视角度 */
    75% {
        transform: 
            rotateX(55deg) 
            rotateY(0deg) 
            rotateZ(-360deg) 
            scale(0.6); /* 保持旋转和缩放状态 */
    }
    
    /* 75% - 100%（吸附合拢）: 重新回到正面放大状态 */
    100% {
        transform: 
            rotateX(0deg) 
            rotateY(0deg) 
            rotateZ(0deg) 
            scale(1.3); /* 回到初始状态 */
    }
}

/* 图层动画 - 紧凑版间距 */
@keyframes compactLayerAnimation {
    /* 0% - 20%（初始海报态）: 所有图层完全重叠 */
    0%, 20% {
        transform: 
            translateZ(0) 
            translateX(0) 
            translateY(0);
        opacity: 1;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 20% - 45%（开始展开）: 轻微分离 */
    45% {
        transform: 
            translateZ(calc(var(--layer-index) * 25px)) 
            translateX(calc(var(--layer-index) * 8px)) 
            translateY(calc(var(--layer-index) * 8px));
        opacity: 0.9;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 45% - 75%（紧凑展开态）: 严格按照指令的固定值 */
    75% {
        /* 紧急任务：图层间距固定值
           05层 translateZ(100px)   --layer-index=4
           04层 translateZ(50px)    --layer-index=3  
           03层 0                   --layer-index=2
           02层 -50px               --layer-index=1
           01层 -100px              --layer-index=0
           
           计算公式: translateZ(calc((var(--layer-index) - 2) * 50px))
        */
        transform: 
            translateZ(calc((var(--layer-index) - 2) * 50px)) 
            translateX(calc(var(--layer-index) * 15px))  /* 斜向偏移量：每一层相较前一层，在 X 轴向右偏移 15px */
            translateY(calc(var(--layer-index) * 15px)); /* 斜向偏移量：每一层相较前一层，在 Y 轴向下偏移 15px */
        opacity: 0.95;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 75% - 100%（吸附合拢）: 回到完全重叠状态 */
    100% {
        transform: 
            translateZ(0) 
            translateX(0) 
            translateY(0);
        opacity: 1;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
}

