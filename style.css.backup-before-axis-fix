/* 鍥惧儚婊戝潡 */
.image-slider {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.slider-container {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
}

.slider-before,
.slider-after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.slider-after {
    /* After鍥惧缁?00%瀹藉害锛屼綔涓烘暣涓粍浠剁殑搴曡壊 */
    z-index: 1;
}

.slider-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.slider-label {
    position: absolute;
    top: 20px;
    padding: 8px 16px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    z-index: 3;
}

/* 璋冩暣鏍囩浣嶇疆锛欰fter鍦ㄥ乏渚э紝Before鍦ㄥ彸渚?*/
.slider-after .slider-label {
    left: 20px;  /* After鏍囩鍦ㄥ乏渚?*/
}

.slider-before .slider-label {
    right: 20px; /* Before鏍囩鍦ㄥ彸渚?*/
}

.slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    background: rgba(255, 255, 255, 0.8);
    transform: translateX(-50%);
    z-index: 2;
    cursor: ew-resize;
}

.handle-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #a5f3fc, #6688ff);
    box-shadow: 0 0 20px rgba(165, 243, 252, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% {
        box-shadow: 0 0 20px rgba(165, 243, 252, 0.5);
    }
    50% {
        box-shadow: 0 0 40px rgba(165, 243, 252, 0.8);
    }
}

