/* 鍏ㄥ眬鏍峰紡 */
html {
    overflow-x: hidden;
    max-width: 100vw;
}

/* 修复图层动画 - 与容器动画同步 */
@keyframes fixedRotateLayerAnimation {
    /* 阶段 1: 正面合拢 - 完全重叠展示05.jpg (0-20%) */
    0%, 20% {
        transform: 
            translateZ(0) 
            translateX(0) 
            translateY(0);
        opacity: 1;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 阶段 2: 开始旋转 - 轻微分离 (20-40%) */
    40% {
        transform: 
            translateZ(calc(var(--layer-index) * 20px)) /* 轻微Z轴分离 */
            translateX(calc(var(--layer-index) * 10px))  /* 轻微X轴偏移 */
            translateY(calc(var(--layer-index) * 8px)); /* 轻微Y轴偏移 */
        opacity: 1;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 阶段 3: 旋转落位到3D展开状态 (40-45%) */
    45% {
        transform: 
            translateZ(calc(var(--layer-index) * 108px)) /* 视觉微调：Z轴间距缩小40%，从180px减少到108px */
            translateX(calc(var(--layer-index) * 18px))  /* 视觉微调：X轴偏移减少40%，从30px减少到18px */
            translateY(calc(var(--layer-index) * 12px)); /* 视觉微调：Y轴偏移减少40%，从20px减少到12px */
        opacity: 0.95;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 阶段 4: 维持3D斜向展开状态 (45-70%) */
    70% {
        transform: 
            translateZ(calc(var(--layer-index) * 108px)) /* 保持紧凑间距 */
            translateX(calc(var(--layer-index) * 18px)) 
            translateY(calc(var(--layer-index) * 12px));
        opacity: 0.95;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 阶段 5: 开始合拢 (70-80%) */
    80% {
        transform: 
            translateZ(calc(var(--layer-index) * 54px)) /* 开始合拢，间距减半 */
            translateX(calc(var(--layer-index) * 9px)) 
            translateY(calc(var(--layer-index) * 6px));
        opacity: 0.98;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 阶段 6: 继续合拢 (80-90%) */
    90% {
        transform: 
            translateZ(calc(var(--layer-index) * 10px)) /* 几乎完全合拢 */
            translateX(calc(var(--layer-index) * 2px)) 
            translateY(calc(var(--layer-index) * 1px));
        opacity: 1;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
    
    /* 阶段 7: 回到完全重叠状态 (90-100%) */
    100% {
        transform: 
            translateZ(0) 
            translateX(0) 
            translateY(0);
        opacity: 1;
        filter: var(--layer-shadow);
        backface-visibility: hidden;
    }
}



* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Noto Sans SC', sans-serif;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #ffffff;
    overflow-x: hidden;
    max-width: 100vw;
    line-height: 1.6;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* 瀵艰埅鏍?*/
nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    backdrop-filter: blur(25px) saturate(180%);
    background: rgba(26, 26, 46, 0.8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}

nav .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
}

.logo {
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, #a5f3fc, #6688ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
}

.nav-links a:hover {
    color: #ffffff;
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(135deg, #a5f3fc, #6688ff);
    transition: width 0.3s ease;
}

.nav-links a:hover::after {
    width: 100%;
}

/* 鑻遍泟鍖哄煙 */
.hero {
    height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('hero-background.jpg') no-repeat center center / cover;
    filter: brightness(0.7);
    z-index: -1;
    animation: parallax 20s ease-in-out infinite;
}

.hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, transparent 30%);
    z-index: -1;
}

@keyframes parallax {
    0%, 100% {
        transform: scale(1) translate(0, 0);
    }
    50% {
        transform: scale(1.05) translate(0, -10px);
    }
}

.hero-content {
    max-width: 800px;
    padding: 20px;
}

.hero-content h1 {
    font-size: clamp(2rem, 8vw, 5rem);
